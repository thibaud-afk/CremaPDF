{
  "name": "cremapdf",
  "version": "1.3.0",
  "description": "Votre atelier PDF personnel, local et gratuit",
  "author": "CREMALAB",
  "main": "main.cjs",
  "scripts": {
    "start": "node prepare-assets.cjs && electron .",
    "build": "node prepare-assets.cjs && electron-builder --win nsis --x64",
    "test": "node --test tests/printing.test.cjs tests/placement.test.mjs && node tests/update.test.cjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0"
  },
  "build": {
    "appId": "fr.cremalab.cremapdf",
    "productName": "CremaPDF",
    "directories": {
      "output": "release",
      "app": "desktop-app"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "app.js",
      "style.css",
      "icon.png",
      "icon.ico",
      "LICENSE",
      "vendor/**/*",
      "!**/node_modules{,/**/*}",
      "updates.cjs",
      "print-pages.mjs",
      "print.html",
      "print.css",
      "print.js",
      "printers.cjs",
      "printer-capabilities.ps1",
      "placement.mjs",
      "print-ui.mjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CremaPDF",
      "include": "installer.nsh",
      "uninstallDisplayName": "CremaPDF — Désinstaller",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Editor"
      }
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thibaud-afk/CremaPDF.git"
  }
}
